
# Build ONLY Xiaomi Mi Router AX3000T (single-profile mode)
# Overrides devices/common/.config: CONFIG_TARGET_ALL_PROFILES=y / CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y
